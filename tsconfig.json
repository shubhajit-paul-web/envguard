{
    "compilerOptions": {
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "strict": true,
        "exactOptionalPropertyTypes": true,
        "declaration": true,
        "declarationMap": false,
        "sourceMap": false,
        "outDir": "dist",
        "rootDir": "src",
        "noEmitOnError": true,
        "skipLibCheck": true
    },
    "include": ["src/**/*"]
}
